<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Account"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:layout_marginBottom="20dp" />

        <!-- Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Profile Image -->
                <ImageView
                    android:id="@+id/ivPhotoSignupFragment"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="18dp"
                    android:src="@mipmap/ic_profile"
                    android:background="#DDDDDD"
                    android:scaleType="centerCrop" />

                <!-- Username -->
                <EditText
                    android:id="@+id/etUsernameSignup"
                    style="@style/ModernEditText"
                    android:hint="Email / Username"
                    android:inputType="textEmailAddress" />

                <!-- First Name -->
                <EditText
                    android:id="@+id/etFirstnameSignupFragment"
                    style="@style/ModernEditText"
                    android:hint="First Name" />

                <!-- Last Name -->
                <EditText
                    android:id="@+id/etLastnameSignupFragment"
                    style="@style/ModernEditText"
                    android:hint="Last Name" />

                <!-- Phone -->
                <EditText
                    android:id="@+id/etPhoneSignupFragment"
                    style="@style/ModernEditText"
                    android:hint="Phone"
                    android:inputType="phone" />

                <!-- Address -->
                <EditText
                    android:id="@+id/etAddressSignupFragment"
                    style="@style/ModernEditText"
                    android:hint="Address" />

                <!-- Password -->
                <EditText
                    android:id="@+id/etPasswordSignup"
                    style="@style/ModernEditText"
                    android:hint="Password"
                    android:inputType="textPassword" />

                <!-- Confirm Password -->
                <EditText
                    android:id="@+id/etConfirmPasswordSignupFragment"
                    style="@style/ModernEditText"
                    android:hint="Confirm Password"
                    android:inputType="textPassword" />

                <!-- Signup Button -->
                <Button
                    android:id="@+id/btnSignupSignup"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="18dp"
                    android:backgroundTint="#5B6CFF"
                    android:text="Sign Up"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>