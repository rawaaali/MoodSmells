<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Image -->
        <ImageView
            android:id="@+id/ivMemoryDetailsFragment"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_fav"
            android:layout_marginBottom="16dp" />

        <!-- Info Block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="4dp">

            <TextView
                android:id="@+id/tvSmellNameDetailsFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Smell Name"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvSmellIntensityDetailsFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Smell Intensity"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvMemoryTypeDetailsFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Memory Type"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvPhoneDetailsFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phone"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvMemoryIdDetailsFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Memory ID"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvSmellSourceDetailsFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Smell Source"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvMemoryDateDetailsFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Memory Date"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvSmellColorDetailsFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Smell Color"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvSmellCategoryDetailsFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Smell Category"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvMemoryDescriptionDetailsFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Memory Description"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvMemoryLocationDetailsFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Memory Location"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvSmellStrengthDetailsFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Smell Strength"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvSmellStyleDetailsFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Smell Style"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvFeelingDetailsFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Feeling"
                android:layout_marginBottom="10dp" />

        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btnSMS"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="SMS"
                android:backgroundTint="#5B6CFF"
                android:textColor="#FFFFFF"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnWhatsApp"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="WhatsApp"
                android:backgroundTint="#25D366"
                android:textColor="#FFFFFF"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnCall"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="Call"
                android:backgroundTint="#FF5252"
                android:textColor="#FFFFFF"
                android:textAllCaps="false" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>