<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollMemoryDetails"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/linearMemoryDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Memory Image -->
        <ImageView
            android:id="@+id/ivMemoryDetailsFragment"
            android:layout_width="match_parent"
            android:layout_height="500dp"
            android:scaleType="centerCrop"
            android:contentDescription="Memory Photo"
            android:src="@drawable/ic_fav"
            android:layout_marginBottom="16dp" />

        <!-- Smell Name -->
        <TextView
            android:id="@+id/tvSmellNameDetailsFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smell Name"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="8dp" />

        <!-- Smell Intensity -->
        <TextView
            android:id="@+id/tvSmellIntensityDetailsFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smell Intensity"
            android:layout_marginBottom="8dp" />

        <!-- Memory Type -->
        <TextView
            android:id="@+id/tvMemoryTypeDetailsFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Memory Type"
            android:layout_marginBottom="8dp" />

        <!-- Phone -->
        <TextView
            android:id="@+id/tvPhoneDetailsFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phone"
            android:layout_marginBottom="8dp" />

        <!-- Memory ID -->
        <TextView
            android:id="@+id/tvMemoryIdDetailsFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Memory ID"
            android:layout_marginBottom="8dp" />

        <!-- Smell Source -->
        <TextView
            android:id="@+id/tvSmellSourceDetailsFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smell Source"
            android:layout_marginBottom="8dp" />

        <!-- Memory Date -->
        <TextView
            android:id="@+id/tvMemoryDateDetailsFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Memory Date"
            android:layout_marginBottom="8dp" />

        <!-- Smell Color -->
        <TextView
            android:id="@+id/tvSmellColorDetailsFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smell Color"
            android:layout_marginBottom="8dp" />

        <!-- Smell Category -->
        <TextView
            android:id="@+id/tvSmellCategoryDetailsFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smell Category"
            android:layout_marginBottom="8dp" />

        <!-- Memory Description -->
        <TextView
            android:id="@+id/tvMemoryDescriptionDetailsFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Memory Description"
            android:layout_marginBottom="8dp" />

        <!-- Memory Location -->
        <TextView
            android:id="@+id/tvMemoryLocationDetailsFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Memory Location"
            android:layout_marginBottom="8dp" />

        <!-- Smell Strength -->
        <TextView
            android:id="@+id/tvSmellStrengthDetailsFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smell Strength"
            android:layout_marginBottom="8dp" />

        <!-- Smell Style -->
        <TextView
            android:id="@+id/tvSmellStyleDetailsFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smell Style"
            android:layout_marginBottom="8dp" />

        <!-- Feeling -->
        <TextView
            android:id="@+id/tvFeelingDetailsFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Feeling"
            android:layout_marginBottom="16dp" />

        <!-- Buttons: SMS, WhatsApp, Call -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="3"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnSMS"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Send SMS" />

            <Button
                android:id="@+id/btnWhatsApp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="WhatsApp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnCall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Call" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>